{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sattrackapp.com/contracts/object_detail.schema.json",
  "title": "SatTrack object_detail dataset",
  "description": "What the globe's selection panel shows beyond the objects dataset: organisations with their roles, launch, status detail, physical facts and where each came from (docs/app-data-contract.md, decisions D-010, D-054; roadmap 3.4). One record per object in the objects dataset, keyed by satcat_id. Written by pipeline/scripts/export_app_csvs.py, which validates every record against this schema before publishing. Field names are the dbt mart column names; their definitions are in the dbt docs. Dates are ISO text with the precision GCAT gives in the matching *_precision field. Additive changes keep the schema number; renaming a field or changing its meaning raises it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "schema", "count", "generated_at", "run_id", "key", "attribution", "caution", "records"],
  "properties": {
    "dataset": {"const": "object_detail"},
    "schema": {"const": 1},
    "count": {"type": "integer", "minimum": 0, "description": "Number of records; equals the length of records."},
    "generated_at": {"type": "string", "format": "date-time", "description": "When the export wrote the file (UTC)."},
    "run_id": {"type": ["string", "null"], "description": "Pipeline run that built the tracking mart."},
    "key": {"const": "satcat_id"},
    "attribution": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "caution": {"type": "string", "minLength": 1},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "nullable_text": {"type": ["string", "null"]},
    "list": {"type": "array", "items": {"type": "string"}, "description": "Always a list, in the mart's order; empty when there are none."},
    "flag": {"type": "integer", "enum": [0, 1]},
    "nullable_flag": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "datetime": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$", "description": "UTC, %Y-%m-%dT%H:%M:%S; read with its *_precision field."},
    "precision": {"type": ["string", "null"], "pattern": "^(second|minute|hour|centiday|day|month|quarter|year|decade|century|millennium|current|unknown)\\??$", "description": "GCAT's Vague Date precision, as the pipeline's helper__parse_vague_date_precision macro sets it; a trailing ? marks an uncertain date."},
    "nullable_number": {"type": ["number", "null"]},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "satcat_id", "jcat", "jcat_link_method", "object_type_source",
        "operational_status_source", "flag_still_operating", "flag_still_transmitting",
        "end_operation_date", "end_operation_date_precision", "end_transmission_date", "end_transmission_date_precision",
        "end_of_life_code", "flag_orbit_conflict",
        "owner_country_codes", "owner_country_source", "owner_org_codes", "owner_org_names", "operator_name",
        "manufacturer_org_codes", "manufacturer_org_names", "launch_agency_org_codes", "launch_agency_org_names",
        "launch_datetime", "launch_datetime_precision", "launch_details_source", "flag_catalog_match_uncertain",
        "site_code", "site_name", "site_latitude", "site_longitude", "launch_vehicle_type", "launch_vehicle_family",
        "flight_id", "satellite_program", "satellite_program_family", "constellation_plane", "mission_details_source",
        "apoapsis", "periapsis", "rcs_size", "mass_kg", "flag_mass_estimated", "dry_mass_kg", "span_m", "gcat_updated_at"
      ],
      "properties": {
        "satcat_id": {"type": "integer", "minimum": 1, "description": "Catalogue number (NORAD_CAT_ID); the key, as in the objects dataset."},
        "jcat": {"$ref": "#/$defs/nullable_text", "description": "GCAT's catalogue ID, e.g. S25544; null when not matched."},
        "jcat_link_method": {"$ref": "#/$defs/nullable_text"},
        "object_type_source": {"$ref": "#/$defs/nullable_text"},
        "operational_status_source": {"$ref": "#/$defs/nullable_text"},
        "flag_still_operating": {"$ref": "#/$defs/nullable_flag"},
        "flag_still_transmitting": {"$ref": "#/$defs/nullable_flag"},
        "end_operation_date": {"$ref": "#/$defs/datetime"},
        "end_operation_date_precision": {"$ref": "#/$defs/precision"},
        "end_transmission_date": {"$ref": "#/$defs/datetime"},
        "end_transmission_date_precision": {"$ref": "#/$defs/precision"},
        "end_of_life_code": {"$ref": "#/$defs/nullable_text"},
        "flag_orbit_conflict": {"$ref": "#/$defs/flag"},
        "owner_country_codes": {"$ref": "#/$defs/list"},
        "owner_country_source": {"$ref": "#/$defs/nullable_text"},
        "owner_org_codes": {"$ref": "#/$defs/list"},
        "owner_org_names": {"$ref": "#/$defs/list"},
        "operator_name": {"$ref": "#/$defs/nullable_text"},
        "manufacturer_org_codes": {"$ref": "#/$defs/list"},
        "manufacturer_org_names": {"$ref": "#/$defs/list"},
        "launch_agency_org_codes": {"$ref": "#/$defs/list"},
        "launch_agency_org_names": {"$ref": "#/$defs/list"},
        "launch_datetime": {"$ref": "#/$defs/datetime"},
        "launch_datetime_precision": {"$ref": "#/$defs/precision"},
        "launch_details_source": {"$ref": "#/$defs/nullable_text"},
        "flag_catalog_match_uncertain": {"$ref": "#/$defs/flag"},
        "site_code": {"$ref": "#/$defs/nullable_text"},
        "site_name": {"$ref": "#/$defs/nullable_text"},
        "site_latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "site_longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "launch_vehicle_type": {"$ref": "#/$defs/nullable_text"},
        "launch_vehicle_family": {"$ref": "#/$defs/nullable_text"},
        "flight_id": {"$ref": "#/$defs/nullable_text"},
        "satellite_program": {"$ref": "#/$defs/nullable_text"},
        "satellite_program_family": {"$ref": "#/$defs/nullable_text"},
        "constellation_plane": {"$ref": "#/$defs/nullable_text"},
        "mission_details_source": {"$ref": "#/$defs/nullable_text"},
        "apoapsis": {"$ref": "#/$defs/nullable_number", "description": "Apogee height, km (Space-Track APOAPSIS)."},
        "periapsis": {"$ref": "#/$defs/nullable_number", "description": "Perigee height, km (Space-Track PERIAPSIS)."},
        "rcs_size": {"$ref": "#/$defs/nullable_text"},
        "mass_kg": {"type": ["number", "null"], "minimum": 0},
        "flag_mass_estimated": {"$ref": "#/$defs/flag"},
        "dry_mass_kg": {"type": ["number", "null"], "minimum": 0},
        "span_m": {"type": ["number", "null"], "minimum": 0},
        "gcat_updated_at": {"$ref": "#/$defs/datetime", "description": "When GCAT last updated its catalogue: the as-of date of the GCAT fields."}
      }
    }
  }
}
