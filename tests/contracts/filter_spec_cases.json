    {"satcat_id": 2, "object_name": "BRAVO", "object_type": "PAYLOAD", "operational_status": "Inactive", "orbit_class": "GEO", "owner_country": "France", "launch_vehicle_brand": "Ariane", "mission_category_labels": ["Communications", "Navigation"], "launch_year": 1999, "satellite_constellation_name": null, "primary_satellite_system_name": "Galileo", "satellite_system_names": ["Galileo"]},
