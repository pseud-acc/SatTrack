    {"satcat_id": 4, "object_name": "DELTA R/B", "object_type": "ROCKET BODY", "operational_status": "Inactive", "orbit_class": "MEO", "owner_country": "China", "launch_vehicle_brand": "Chang Zheng", "mission_category_labels": null, "launch_year": null, "satellite_constellation_name": null, "primary_satellite_system_name": null, "satellite_system_names": null},
    {"satcat_id": 5, "object_name": "ECHO", "object_type": "PAYLOAD", "operational_status": "Active", "orbit_class": null, "owner_country": "United States", "launch_vehicle_brand": "Falcon", "mission_category_labels": ["Earth observation"], "launch_year": 2020, "satellite_constellation_name": null, "primary_satellite_system_name": "GOES", "satellite_system_names": ["GOES", "Search & Rescue (SARSAT)"]},
    {"satcat_id": 6, "object_name": null, "object_type": "UNKNOWN", "operational_status": null, "orbit_class": null, "owner_country": null, "launch_vehicle_brand": null, "mission_category_labels": [], "launch_year": null, "satellite_constellation_name": null, "primary_satellite_system_name": null, "satellite_system_names": []}
