  "valid": [
    {"name": "no clauses selects everything", "spec": {"version": 1, "clauses": []}, "expected": [1, 2, 3, 4, 5, 6]},
    {"name": "eq", "spec": {"version": 1, "clauses": [{"field": "orbit_class", "op": "eq", "value": "LEO"}]}, "expected": [1, 3]},
    {"name": "eq on an integer", "spec": {"version": 1, "clauses": [{"field": "satcat_id", "op": "eq", "value": 4}]}, "expected": [4]},
    {"name": "in", "spec": {"version": 1, "clauses": [{"field": "operational_status", "op": "in", "value": ["Active"]}]}, "expected": [1, 5]},
    {"name": "in with null keeps missing", "spec": {"version": 1, "clauses": [{"field": "operational_status", "op": "in", "value": ["Inactive", null]}]}, "expected": [2, 3, 4, 6]},
    {"name": "in only null is the same as is_missing", "spec": {"version": 1, "clauses": [{"field": "owner_country", "op": "in", "value": [null]}]}, "expected": [3, 6]},
    {"name": "not_in is the complement of in: missing kept", "spec": {"version": 1, "clauses": [{"field": "owner_country", "op": "not_in", "value": ["United States"]}]}, "expected": [2, 3, 4, 6]},
    {"name": "not_in with null drops missing", "spec": {"version": 1, "clauses": [{"field": "owner_country", "op": "not_in", "value": ["United States", null]}]}, "expected": [2, 4]},
    {"name": "between is inclusive and drops missing", "spec": {"version": 1, "clauses": [{"field": "launch_year", "op": "between", "value": {"min": 1999, "max": 2007}}]}, "expected": [2, 3]},
    {"name": "between with include_missing", "spec": {"version": 1, "clauses": [{"field": "launch_year", "op": "between", "value": {"min": 2008, "max": 2030, "include_missing": true}}]}, "expected": [1, 4, 5, 6]},
    {"name": "between a single year", "spec": {"version": 1, "clauses": [{"field": "launch_year", "op": "between", "value": {"min": 2020, "max": 2020}}]}, "expected": [1, 5]},
    {"name": "contains_any", "spec": {"version": 1, "clauses": [{"field": "mission_category_labels", "op": "contains_any", "value": ["Navigation", "Earth observation"]}]}, "expected": [2, 5]},
    {"name": "contains_any with null matches null and empty lists", "spec": {"version": 1, "clauses": [{"field": "mission_category_labels", "op": "contains_any", "value": ["Communications", null]}]}, "expected": [1, 2, 3, 4, 6]},
    {"name": "is_missing true on a list counts empty as missing", "spec": {"version": 1, "clauses": [{"field": "mission_category_labels", "op": "is_missing", "value": true}]}, "expected": [3, 4, 6]},
    {"name": "is_missing false", "spec": {"version": 1, "clauses": [{"field": "object_name", "op": "is_missing", "value": false}]}, "expected": [1, 2, 3, 4, 5]},
    {"name": "clauses are AND-ed", "spec": {"version": 1, "clauses": [{"field": "object_type", "op": "in", "value": ["PAYLOAD"]}, {"field": "owner_country", "op": "eq", "value": "United States"}, {"field": "launch_year", "op": "between", "value": {"min": 2020, "max": 2020}}]}, "expected": [1, 5]},
    {"name": "contradictory clauses select nothing", "spec": {"version": 1, "clauses": [{"field": "object_name", "op": "eq", "value": "ALPHA"}, {"field": "satcat_id", "op": "eq", "value": 2}]}, "expected": []},
    {"name": "the same field twice narrows", "spec": {"version": 1, "clauses": [{"field": "orbit_class", "op": "in", "value": ["LEO", "GEO"]}, {"field": "orbit_class", "op": "not_in", "value": ["GEO"]}]}, "expected": [1, 3]},
    {"name": "constellation: one of", "spec": {"version": 1, "clauses": [{"field": "satellite_constellation_name", "op": "in", "value": ["Starlink"]}]}, "expected": [1]},
    {"name": "constellation: null listed matches objects in none", "spec": {"version": 1, "clauses": [{"field": "satellite_constellation_name", "op": "in", "value": ["Starlink", null]}]}, "expected": [1, 2, 3, 4, 5, 6]},
    {"name": "system: any system the object is part of, hosted payloads included", "spec": {"version": 1, "clauses": [{"field": "satellite_system_names", "op": "contains_any", "value": ["Search & Rescue (SARSAT)"]}]}, "expected": [5]},
    {"name": "system: any of several", "spec": {"version": 1, "clauses": [{"field": "satellite_system_names", "op": "contains_any", "value": ["Galileo", "GOES"]}]}, "expected": [2, 5]},
    {"name": "system: null listed matches a missing or empty list", "spec": {"version": 1, "clauses": [{"field": "satellite_system_names", "op": "contains_any", "value": [null]}]}, "expected": [1, 3, 4, 6]},
    {"name": "primary system: the system it was built for", "spec": {"version": 1, "clauses": [{"field": "primary_satellite_system_name", "op": "in", "value": ["GOES"]}]}, "expected": [5]},
    {"name": "primary system: a hosted system is not the primary one", "spec": {"version": 1, "clauses": [{"field": "primary_satellite_system_name", "op": "in", "value": ["Search & Rescue (SARSAT)"]}]}, "expected": []}
  ],
