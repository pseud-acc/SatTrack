# CI pipeline environment (.github/workflows/pipeline.yml): Linux x86_64, Python 3.12.3.
# Same top-level pins as ../requirements.txt, plus boto3 (Secrets Manager credentials, S3 state).
# dbt-oss: PyPI has only a source package that downloads the platform wheel at install time; here the
# Linux wheel is pinned directly from the dbt release, with the sha256 that package's assets.json lists
# (6a9df409...f9e6), so pip --require-hashes verifies it and nothing unhashed is built.
# Regenerate requirements/pipeline.txt with:
#   uv pip compile requirements/pipeline.in -c requirements.lock.txt --generate-hashes
#     --python-version 3.12 --python-platform x86_64-manylinux_2_28 -o requirements/pipeline.txt
dbt-oss @ https://github.com/dbt-labs/dbt/releases/download/v2.0.8/dbt_oss-2.0.8-cp310-abi3-manylinux_2_28_x86_64.whl#sha256=6a9df409a6953b33af6f9827d8663e5b55a84b5ae84b2a453154a9c58097f9e6
duckdb==2.0.0
geonamescache==3.0.2
pycountry==24.6.1
requests==2.34.2
boto3
